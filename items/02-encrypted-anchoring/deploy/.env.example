# Copy to items/02-encrypted-anchoring/deploy/.env and fill in.
# .env is gitignored. Never commit it, never paste its contents anywhere.

# --- required ---------------------------------------------------------------

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- the Ethereum signer: pick exactly one ----------------------------------

# PREFERRED for the contract deploy. The key never appears in argv or here.
#   cast wallet import canonical-deployer --interactive
DEPLOYER_ACCOUNT=canonical-deployer
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# The anchor-writer is a viem CLI and cannot read a Foundry keystore, so
# posting anchors needs a raw key in the environment. Set it for that step and
# unset it afterwards, or use DEPLOYER_PRIVATE_KEY below for the whole run and
# rotate the key when the canonical deployment is finished.
# ANCHOR_WRITER_PRIVATE_KEY=

# FALLBACK for everything. argv is readable by other users via `ps`.
# DEPLOYER_PRIVATE_KEY=

# --- the canonical stream: all three MUST be outside this repository --------
#
# The scripts refuse to run if any of these resolves inside the working tree.
# The keyfile is not an Ethereum key and holds no funds, but anyone holding it
# can compute valid envelopes for the canonical stream and post conflicting
# anchors from any funded account, because AnchorDataEdge is permissionless.
# The checker flags those as CONFLICT — detectable, but still a worse demo.
#
# It stops being a secret when the disclosure bundle is published. That is
# deliberate: the bundle is what makes a stranger's verification possible.

ANCHOR_KEYSTORE=$HOME/.graph-privacy-showcase/canonical/item02-stream-keyfile.json
ANCHOR_ARCHIVE=$HOME/.graph-privacy-showcase/canonical/item02-archive.json
ANCHOR_DISCLOSURE=$HOME/.graph-privacy-showcase/canonical/item02-disclosure

# --- optional ---------------------------------------------------------------

# Records to anchor. Default is the committed 10-record fixture, which is what
# makes the canonical stream reproducible by a stranger.
# ANCHOR_RECORDS=

# Also post a junk payload and a duplicate, so the canonical index is seen
# reporting MalformedAnchor and duplicateCount rather than dropping them.
# SEED_EDGE_CASES=1

# Chain guard. 11155111 is Ethereum Sepolia.
# EXPECTED_CHAIN_ID=11155111
