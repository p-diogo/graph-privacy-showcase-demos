# Everything generated by a build or a run. `build/` is already ignored at the
# repo root; these are the tool-specific outputs that are not.

# Foundry
src/contracts/out/
src/contracts/cache/
src/contracts/broadcast/
# Symlinks into build/poc/, created by src/poc/fetch-poc.sh. These point at
# EthSystems' code and their pinned submodules; none of it is ours to commit.
src/contracts/lib/

# Subgraph codegen and rendered manifests
src/subgraph/generated/
src/subgraph/build/
src/subgraph/subgraph.local.yaml
src/subgraph/subgraph.fallback-a.local.yaml
# Rendered by deploy/05-render-manifest.sh. A pinned address that is not the
# one you deployed is a lie waiting to be copied, so the rendered manifests
# stay out of git; deploy/canonical.json carries the recorded values.
src/subgraph/subgraph.sepolia.yaml
src/subgraph/subgraph.fallback-a.sepolia.yaml
src/subgraph/tests/.latest.json
src/subgraph/tests/.bin/
