# Copy to items/01-private-bond-replay/deploy/.env and fill in.
# .env is gitignored. Never commit it, never paste its contents into an issue,
# a chat, or a report.

# --- required ---------------------------------------------------------------

# A Sepolia RPC endpoint. Any provider; an archive node is not required for
# deploying and seeding. Use your own — the on-chain cross-check is the only
# part of this system whose trust is anchored somewhere other than the serving
# layer, and it is worth nothing if the endpoint was chosen for you.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- the signer: pick exactly one -------------------------------------------

# PREFERRED. An encrypted Foundry keystore. The key never appears in argv, in
# this file, or in the environment; forge prompts for the password.
#
#   cast wallet import canonical-deployer --interactive
#   cast wallet address --account canonical-deployer
#
DEPLOYER_ACCOUNT=canonical-deployer
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# FALLBACK. A raw key. Works, but argv is readable by other users on the same
# machine via `ps`, and a key in a dotfile is a key you will forget to rotate.
# If you use this, rotate it after the canonical deployment is done.
# DEPLOYER_PRIVATE_KEY=

# --- optional ---------------------------------------------------------------

# Seconds between deploy and bond maturity. The four pre-maturity entry points
# must all confirm inside this window; the burn runs after it. Default 3600
# (spec §4.2). Do not shorten below the time you need for step 2 to confirm.
# MATURITY_LEAD_SECS=3600

# A deliberately fictional ISIN-format identifier. "XF" is not an ISO 3166-1
# alpha-2 code, so it cannot collide with an issued ISIN. Do not put a real
# security's identifier here.
# BOND_ID_STRING=XF0000000001

# Chain guard. 11155111 is Ethereum Sepolia. The scripts refuse to run against
# anything else unless you override this — which is how the local dry-run
# against anvil (31337) has to say out loud that it is not Sepolia.
# EXPECTED_CHAIN_ID=11155111
